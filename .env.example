# Server-side OpenAI key for plan generation. Never add a real key to the website.
OPENAI_API_KEY=replace-with-your-own-server-side-key
OPENAI_MODEL=gpt-6-astra
# Keep both the GitHub Pages origin (during redirect) and the Render canonical site.
ALLOWED_ORIGINS=https://zencoding715-create.github.io,https://sof-prep-ai.onrender.com
# Render Postgres internal connection URL. Configure this as a secret in Render.
DATABASE_URL=postgres://user:password@host/database
# Exactly 64 hexadecimal characters. Generate once and keep it as a Render secret.
PLAN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Private owner dashboard key. Use a unique random secret of at least 32 bytes.
# Keep it in Render's secret environment settings; never commit or share it.
ADMIN_ACCESS_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
PORT=10000
